#!/opt/homebrew/bin/bash

# Initialize globals
XCLI_FOLDER=".xcli"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Shared helper: fail with an error message and exit with -1
fail() {
	echo "❌ ERROR: $1" >&2
	exit -1
}

mkdir -p $XCLI_FOLDER

# Colored intro output
echo ""
echo -e "\033[1;36m╔════════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;36m║\033[1;33m          Xcli Tools                            \033[1;36m║\033[0m"
echo -e "\033[1;36m║\033[0m                                                \033[1;36m║\033[0m"
echo -e "\033[1;36m║\033[0m  iOS/Xcode project automation toolkit          \033[1;36m║\033[0m"
echo -e "\033[1;36m║\033[0m                                                \033[1;36m║\033[0m"
echo -e "\033[1;36m║\033[0m  - setup  : scan and cache projects/schemes    \033[1;36m║\033[0m"
echo -e "\033[1;36m║\033[0m  - build  : build with xcodebuild + xcpretty   \033[1;36m║\033[0m"
echo -e "\033[1;36m╚════════════════════════════════════════════════╝\033[0m"
echo ""

# Source shared utilities

# Source command modules
source $SCRIPT_DIR/setupCommand.sh
source $SCRIPT_DIR/buildCommand.sh
source $SCRIPT_DIR/configCommand.sh
source $SCRIPT_DIR/listCommand.sh
source $SCRIPT_DIR/runCommand.sh
source $SCRIPT_DIR/testCommand.sh

# Dispatch based on first argument
case "$1" in
	setup)
		setupCommand
		;;

	build)
		buildCommand 
		;;

	config)
		configCommand "$2" "$3"
		;;
	
	list)
		listCommand "$2" "$3"
		;;
	
	run)
		runCommand
		;;

	test)
		testCommand
		;;

	*)
		echo "Unknown command: $1"
		echo "Usage: $0 [setup|build|config]"
		exit 1
		;;
esac
